# Copy to .env and fill in ONLY when you swap in production backends.
# (Never commit the real .env — it is in .gitignore.)

# --- Easiest first upgrade: real LLM explanations from Gemini (free key) ---
# TALENTRAG_EXPLAIN_BACKEND=gemini
# GEMINI_API_KEY=your-key-from-aistudio.google.com

# --- Defaults (no keys needed) ---
TALENTRAG_EMBED_BACKEND=local_tfidf      # gemini | openai  (see DEPLOY.md: needs an indexing step first)
TALENTRAG_STORE_BACKEND=local            # pinecone
TALENTRAG_RERANK_BACKEND=local_lexical   # cross_encoder
TALENTRAG_EXPLAIN_BACKEND=local_template # gemini | anthropic
# OPENAI_API_KEY=
# PINECONE_API_KEY=
# ANTHROPIC_API_KEY=
